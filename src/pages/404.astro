---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="The page you are looking for could not be found.">
  <section class="wrap wrap--narrow nf">
    <span class="label">404</span>
    <h1>We couldn’t find that page</h1>
    <p class="lede">It may have moved when we updated our website. These links may help.</p>
    <ul>
      <li><a href="/">Home</a></li>
      <li><a href="/programs#support-groups">Support groups</a></li>
      <li><a href="/events">Events</a></li>
      <li><a href="/support-us">Donate</a></li>
      <li><a href="/contact">Contact</a></li>
    </ul>
  </section>
</Base>

<style>
  .nf {
    padding-block: clamp(4rem, 10vw, 9rem);
  }
  .nf .lede {
    color: var(--ink-2);
    margin: 1rem 0 2rem;
  }
  .nf ul {
    padding-left: 1.2rem;
    display: grid;
    gap: 0.4rem;
    font-size: var(--step-1);
  }
</style>
