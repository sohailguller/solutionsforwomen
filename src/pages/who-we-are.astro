---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import DonateBand from '../components/DonateBand.astro';
import { board, partners } from '../data/board';

const storyPics = [
  { key: 'who/08', alt: 'Two members embracing and smiling' },
  { key: 'who/02', alt: 'Members holding the paintings they made together' },
  { key: 'who/natra-and-shannon', alt: 'Natra and Shannon with a fellow member' },
  { key: 'who/06', alt: 'Members at a community gathering' },
];
---

<Base
  title="Who We Are"
  description="Solutions for Women began in 2010 as a network of women who sought additional therapeutic support after exiting the criminal justice system and recovery programs. Meet our story, board and partners."
  image="who/banner"
>
  <header class="page-head wrap">
    <span class="label">Who we are</span>
    <h1>Finding inspiration in every turn</h1>
    <p class="lede">
      The founding members created a strong foundation for Solutions for Women, fostering sisterhood, a sense of
      community and safety.
    </p>
  </header>

  <figure class="banner">
    <Photo src="who/banner" alt="Solutions for Women members gathered together" sizes="100vw" widths={[800, 1200, 1549]} class="img-cover" loading="eager" />
  </figure>

  <section class="section">
    <div class="wrap intro">
      <p class="big">
        Our intent is to ensure we continue to make a meaningful impact in the lives of women everywhere. Our unwavering
        dedication and combined expertise inspires us every day to strive for a world where every woman can achieve her
        full potential.
      </p>
      <p class="sig">Together, we are phenomenal women.</p>
    </div>
  </section>

  <section class="section section--white story" aria-labelledby="story-h">
    <div class="wrap story-grid">
      <div class="prose">
        <h2 id="story-h">Our story</h2>
        <p>
          Solutions for Women began in 2010 as a network of 10-12 women who sought additional therapeutic support via
          group and social interaction, after exiting the criminal justice system, behavioral modification treatment
          and/or traditional 12-step recovery model programs for themselves. The founding women developed life-long
          friendships and a fulfilling support system, and therefore wanted to take our success to the community.
        </p>
        <p>
          Founding members understood the need for formerly incarcerated women to reconnect socially and understood
          through personal experience how group support can deter participants from relapsing back into unhealthy
          behaviors.
        </p>
        <p>Public, community empowerment groups for women began February 2011, every Tuesday in the Bayview community.</p>
        <a class="more" href="/about">Read the full history</a>
      </div>
      <div class="story-pics">
        {
          storyPics.map((p) => (
            <figure>
              <Photo src={p.key} alt={p.alt} sizes="(min-width: 64rem) 25vw, 50vw" widths={[400, 640, 900]} class="img-cover" />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section board" id="board" aria-labelledby="board-h">
    <div class="wrap">
      <h2 id="board-h">Board members</h2>
      <ul class="people">
        {
          board.map((m) => (
            <li>
              <a href={`/team/${m.slug}`} class="person">
                <span class="headshot">
                  <Photo src={`board/${m.slug}`} alt="" sizes="(min-width: 64rem) 22vw, (min-width: 40rem) 33vw, 50vw" widths={[320, 480, 720]} class="img-cover" position="50% 25%" />
                </span>
                <span class="pname">{m.name}</span>
                <span class="prole">{m.role}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--white partners" aria-labelledby="partners-h">
    <div class="wrap">
      <h2 id="partners-h">Our partners</h2>
      <ul class="logos">
        {
          partners.map((p) => (
            <li>
              <a href={p.url} rel="noopener" title={p.name}>
                <Photo src={p.logo} alt={p.name} sizes="140px" widths={[140, 280]} />
                <span>{p.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <DonateBand />
</Base>

<style>
  .banner :global(img) {
    height: clamp(14rem, 32vw, 30rem);
  }
  .intro {
    max-width: calc(58rem + 2 * var(--gutter));
  }
  .big {
    font-family: var(--serif);
    font-size: var(--step-3);
    line-height: 1.3;
    letter-spacing: -0.01em;
  }
  .sig {
    margin-top: 2rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: var(--step-2);
    color: var(--accent);
  }

  .story-grid {
    display: grid;
    gap: 3rem;
    align-items: start;
  }
  .story-grid .prose p {
    color: var(--ink-2);
  }
  .story-pics {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
  }
  .story-pics figure {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--paper-2);
  }
  @media (min-width: 64rem) {
    .story-grid {
      grid-template-columns: 5fr 6fr;
      gap: 5rem;
    }
  }

  .people {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2.5rem 1.25rem;
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }
  .person {
    display: grid;
    text-decoration: none;
  }
  .headshot {
    display: block;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: var(--paper-2);
    margin-bottom: 1rem;
  }
  .headshot :global(img) {
    filter: saturate(0.92);
    transition: transform 0.4s ease;
  }
  .person:hover .headshot :global(img) {
    transform: scale(1.02);
  }
  .pname {
    font-family: var(--serif);
    font-size: var(--step-2);
    line-height: 1.2;
  }
  .person:hover .pname {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.18em;
  }
  .prole {
    margin-top: 0.2rem;
    color: var(--ink-2);
    font-size: 0.95rem;
  }
  @media (min-width: 40rem) {
    .people {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  @media (min-width: 64rem) {
    .people {
      grid-template-columns: repeat(4, 1fr);
      gap: 3rem 2rem;
    }
  }

  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(10rem, 1fr));
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
    border-top: 1px solid var(--rule);
    border-left: 1px solid var(--rule);
  }
  .logos li {
    background: var(--white);
    border-right: 1px solid var(--rule);
    border-bottom: 1px solid var(--rule);
  }
  .logos a {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 1rem;
    height: 100%;
    padding: 2rem 1.25rem;
    text-align: center;
    text-decoration: none;
    font-size: var(--step--1);
    line-height: 1.4;
    color: var(--ink-2);
  }
  .logos a:hover span {
    color: var(--ink);
    text-decoration: underline;
  }
  @media (min-width: 64rem) {
    .logos {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .logos :global(img) {
    width: auto;
    height: 5.5rem;
    object-fit: contain;
  }
</style>
