---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
---

<Base title="Thank you" description="Thank you for contacting Solutions for Women.">
  <section class="wrap wrap--narrow ty">
    <Mark class="page-mark" />
    <h1 data-msg-title>Thank you</h1>
    <p class="lede" data-msg-body>We have your details and will be in touch soon.</p>
    <div class="actions">
      <a class="btn btn--primary" href="/">Back to home</a>
      <a class="btn btn--outline" href="/events">Upcoming events</a>
    </div>
  </section>
</Base>

<script>
  const form = new URLSearchParams(location.search).get('form');
  const copy: Record<string, [string, string]> = {
    contact: ['Thank you for your message', 'We read every message and will get back to you as soon as we can.'],
    newsletter: ['You’re signed up', 'Look out for our next monthly update and event reminders.'],
    volunteer: ['Thank you for volunteering', 'We will be in touch to confirm your shift. We look forward to seeing you.'],
  };
  const pick = form ? copy[form] : undefined;
  if (pick) {
    document.querySelector('[data-msg-title]')!.textContent = pick[0];
    document.querySelector('[data-msg-body]')!.textContent = pick[1];
  }
</script>

<style>
  .ty :global(.page-mark) {
    width: 4rem;
    height: 4rem;
    margin-bottom: 2rem;
  }
  .ty {
    padding-block: clamp(4rem, 10vw, 9rem);
  }
  .ty .lede {
    color: var(--ink-2);
    margin-top: 1rem;
  }
</style>
