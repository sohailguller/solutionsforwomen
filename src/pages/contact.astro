---
import Base from '../layouts/Base.astro';
import Photo from '../components/Photo.astro';
import { site, tel } from '../data/site';
---

<Base
  title="Contact"
  description="Contact Solutions for Women in San Francisco. Email info@solutionsforwomen.net or call 415-323-6893."
  image="contact/group-teal"
>
  <header class="page-head wrap">
    <span class="label">Contact</span>
    <h1>Stay connected with us</h1>
  </header>

  <section class="wrap contact-grid">
    <div class="details">
      <div class="block">
        <h2>General</h2>
        <p>
          <a href={`mailto:${site.email}`}>{site.email}</a><br />
          <a href={tel(site.phone)}>{site.phone}</a>
        </p>
      </div>
      <div class="block">
        <h2>{site.director.name}, Board President</h2>
        <p>
          <a href={`mailto:${site.director.email}`}>{site.director.email}</a><br />
          <a href={tel(site.director.phone)}>{site.director.phone}</a>
        </p>
      </div>
      <div class="block">
        <h2>Support groups</h2>
        <p>
          {site.supportGroup.day}, {site.supportGroup.time}, {site.supportGroup.where}.<br />
          <a href="/programs#support-groups">Meeting details</a>
        </p>
      </div>
      <div class="block">
        <h2>Follow</h2>
        <p>
          <a href={site.social.facebook} rel="noopener">Facebook</a><br />
          <a href={site.social.linkedin} rel="noopener">LinkedIn</a>
        </p>
      </div>
      <div class="block">
        <h2>Donate</h2>
        <p>
          Registered charity {site.ein}.<br />
          <a href="/support-us">Make a tax-deductible donation</a>
        </p>
      </div>
    </div>

    <div class="form-card">
      <h2>Send us a message</h2>
      <form class="form" name="contact" method="POST" action="/thank-you?form=contact" data-netlify="true" netlify-honeypot="company">
        <input type="hidden" name="form-name" value="contact" />
        <p class="hp"><label>Leave this empty <input name="company" tabindex="-1" autocomplete="off" /></label></p>
        <div class="form-row">
          <div class="field">
            <label for="c-first">First name</label>
            <input id="c-first" name="first-name" autocomplete="given-name" required />
          </div>
          <div class="field">
            <label for="c-last">Last name</label>
            <input id="c-last" name="last-name" autocomplete="family-name" required />
          </div>
        </div>
        <div class="form-row">
          <div class="field">
            <label for="c-email">Email</label>
            <input id="c-email" name="email" type="email" autocomplete="email" required />
          </div>
          <div class="field">
            <label for="c-phone">Phone <span class="opt">(optional)</span></label>
            <input id="c-phone" name="phone" type="tel" autocomplete="tel" />
          </div>
        </div>
        <div class="field">
          <label for="c-subject">Subject</label>
          <input id="c-subject" name="subject" required />
        </div>
        <div class="field">
          <label for="c-message">Message</label>
          <textarea id="c-message" name="message" rows="6" required></textarea>
        </div>
        <div>
          <button class="btn btn--primary" type="submit">Send</button>
        </div>
      </form>
    </div>
  </section>

  <div class="wrap strip">
    <figure><Photo src="contact/group-teal" alt="Members in matching teal shirts at a retreat" sizes="(min-width: 64rem) 50vw, 100vw" class="img-cover" /></figure>
    <figure><Photo src="contact/tent" alt="Volunteers at the Solutions for Women Fleet Week tent" sizes="(min-width: 64rem) 25vw, 50vw" class="img-cover" /></figure>
    <figure><Photo src="contact/wharf-sign" alt="The Fisherman's Wharf of San Francisco sign" sizes="(min-width: 64rem) 25vw, 50vw" class="img-cover" /></figure>
  </div>
</Base>

<style>
  .contact-grid {
    display: grid;
    gap: 3rem;
    padding-bottom: var(--section);
    align-items: start;
  }
  .details {
    display: grid;
    gap: 0;
    border-top: 1px solid var(--ink);
  }
  .block {
    padding: 1.4rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .block h2 {
    font-family: var(--sans);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
    letter-spacing: 0;
    margin-bottom: 0.4rem;
  }
  .block p {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.45;
  }
  .form-card {
    padding: clamp(1.5rem, 4vw, 3rem);
    background: var(--white);
    border: 1px solid var(--rule);
  }
  .form-card h2 {
    font-size: var(--step-3);
    margin-bottom: 1.75rem;
  }
  @media (min-width: 64rem) {
    .contact-grid {
      grid-template-columns: 4fr 7fr;
      gap: 5rem;
    }
  }

  .strip {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.5rem;
    padding-bottom: var(--section);
  }
  .strip figure {
    aspect-ratio: 1;
    overflow: hidden;
  }
  .strip figure:first-child {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }
  @media (min-width: 64rem) {
    .strip {
      grid-template-columns: 2fr 1fr 1fr;
      height: 24rem;
    }
    .strip figure,
    .strip figure:first-child {
      grid-column: auto;
      aspect-ratio: auto;
    }
  }
</style>
