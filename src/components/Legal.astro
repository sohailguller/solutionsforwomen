---
import Base from '../layouts/Base.astro';

interface Props {
  title: string;
  description: string;
  updated: string;
}
const { title, description, updated } = Astro.props;
---

<Base title={title} description={description}>
  <article class="wrap wrap--narrow legal">
    <h1>{title}</h1>
    <p class="updated">Last updated {updated}</p>
    <div class="body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal {
    padding-block: clamp(3rem, 7vw, 6rem) var(--section);
  }
  .legal h1 {
    font-size: var(--step-4);
  }
  .updated {
    color: var(--ink-2);
    font-size: var(--step--1);
    margin-bottom: 3rem;
  }
  .body :global(h2) {
    font-size: var(--step-2);
    font-weight: 500;
    margin-top: 2.5rem;
  }
  .body :global(p),
  .body :global(li) {
    color: var(--ink-2);
  }
  .body :global(ul) {
    padding-left: 1.2rem;
    margin: 0 0 1.1em;
  }
</style>
