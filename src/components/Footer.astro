---
import Logo from './Logo.astro';
import NewsletterForm from './NewsletterForm.astro';
import { site, nav, tel } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap">
    <div class="signup">
      <div>
        <h2>Get monthly updates and event reminders</h2>
        <p>News from our groups, upcoming events and ways to help, about once a month.</p>
      </div>
      <NewsletterForm idPrefix="footer-nl" />
    </div>

    <div class="cols">
      <div class="about">
        <Logo tone="light" />
        <p>We are here to help, support and provide solutions for women in need.</p>
        <p>Join us: connect to groups, volunteer at events, donate to our cause.</p>
      </div>

      <nav aria-label="Footer">
        <h3>Quick links</h3>
        <ul>
          {nav.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          <li><a href="/support-us">Donate</a></li>
        </ul>
      </nav>

      <div>
        <h3>Contact and connect</h3>
        <ul>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={tel(site.phone)}>{site.phone}</a></li>
          <li><a href={site.social.facebook} rel="noopener">Facebook</a></li>
          <li><a href={site.social.linkedin} rel="noopener">LinkedIn</a></li>
        </ul>
      </div>

      <div>
        <h3>Support groups</h3>
        <p>
          Held weekly on {site.supportGroup.day} from {site.supportGroup.time}, {site.supportGroup.where}.
        </p>
        <a href="/programs#support-groups">Meeting details</a>
      </div>
    </div>

    <div class="legal">
      <p>
        &copy; {year} Solutions for Women. A registered 501(c)(3) charity, EIN {site.ein}. Donations are tax-deductible to
        the extent allowed by law.
      </p>
      <p><a href="/terms-of-use">Terms of Use</a> <a href="/privacy-policy">Privacy Policy</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--navy);
    color: var(--paper);
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
    padding-bottom: 2rem;
  }
  .signup {
    display: grid;
    gap: 2rem;
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
    border-bottom: 1px solid rgba(248, 244, 236, 0.18);
  }
  .signup h2 {
    font-size: var(--step-3);
    max-width: 18ch;
  }
  .signup p {
    color: var(--navy-ink);
    max-width: 30rem;
  }
  .signup :global(.field label) {
    color: var(--paper);
  }
  .signup :global(.opt) {
    color: var(--navy-ink);
  }
  .signup :global(.field input) {
    border-color: transparent;
  }
  .signup :global(.btn--primary) {
    background: var(--paper);
    color: var(--navy);
  }
  .signup :global(.btn--primary:hover) {
    background: var(--white);
  }

  .cols {
    display: grid;
    gap: 2.5rem;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .cols h3 {
    font-family: var(--sans);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--amber);
    margin-bottom: 1rem;
  }
  .cols ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.55rem;
  }
  .cols a {
    text-decoration: none;
  }
  .cols a:hover {
    text-decoration: underline;
  }
  .cols p {
    color: var(--navy-ink);
    font-size: 0.975rem;
  }
  .about p {
    max-width: 22rem;
    margin-top: 1.25rem;
  }
  .about p + p {
    margin-top: 0;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(248, 244, 236, 0.18);
    font-size: var(--step--1);
    color: var(--navy-ink);
  }
  .legal p {
    margin: 0;
    max-width: 48rem;
  }
  .legal a {
    margin-right: 1.25rem;
  }
  .legal a:last-child {
    margin-right: 0;
  }

  @media (min-width: 48rem) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  @media (min-width: 64rem) {
    .signup {
      grid-template-columns: 5fr 6fr;
      gap: 5rem;
      align-items: start;
    }
    .cols {
      grid-template-columns: 1.6fr 1fr 1.2fr 1.2fr;
      gap: 3rem;
    }
  }
</style>
