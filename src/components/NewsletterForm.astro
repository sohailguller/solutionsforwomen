---
import Form from './Form.astro';

interface Props {
  idPrefix?: string;
}
const { idPrefix = 'nl' } = Astro.props;
---

<Form name="newsletter" subject="New sign-up: monthly updates" success="You're signed up. Look out for our next update." submit="Sign up">
  <div class="field">
    <label for={`${idPrefix}-name`}>Name</label>
    <input id={`${idPrefix}-name`} name="full-name" autocomplete="name" />
  </div>
  <div class="form-row">
    <div class="field">
      <label for={`${idPrefix}-email`}>Email</label>
      <input id={`${idPrefix}-email`} name="email" type="email" autocomplete="email" required />
    </div>
    <div class="field">
      <label for={`${idPrefix}-phone`}>Phone <span class="opt">(optional)</span></label>
      <input id={`${idPrefix}-phone`} name="phone" type="tel" autocomplete="tel" />
    </div>
  </div>
</Form>
