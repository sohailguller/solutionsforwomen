---
import { site } from '../data/site';
const g = site.supportGroup;
---

<div class="sg">
  <p class="when">
    Held weekly on {g.day} from {g.time}, {g.where}.
  </p>
  <dl>
    <div><dt>Meeting ID</dt><dd>{g.meetingId}</dd></div>
    <div><dt>Passcode</dt><dd>{g.passcode}</dd></div>
    <div><dt>Dial in</dt><dd><a href={`tel:+1${g.dialIn.replace(/\D/g, '').slice(1)}`}>{g.dialIn}</a></dd></div>
  </dl>
  <a class="btn btn--primary" href={g.zoomUrl} rel="noopener">Join on Zoom</a>
</div>

<style>
  .sg {
    margin-top: 1.75rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule);
  }
  .when {
    font-family: var(--serif);
    font-size: var(--step-1);
    line-height: 1.4;
    margin-bottom: 1.25rem;
  }
  dl {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    gap: 1rem 1.5rem;
    margin: 0 0 1.75rem;
  }
  dt {
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  dd {
    margin: 0.15rem 0 0;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  dd a {
    text-decoration: none;
  }
</style>
