---
interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<a href="/" class:list={['logo', `logo--${tone}`]} aria-label="Solutions for Women, home">
  <svg class="mark" viewBox="0 0 40 40" aria-hidden="true">
    <circle cx="20" cy="20" r="18.75" fill="var(--mark-fill)" stroke="var(--mark-stroke)" stroke-width="1.5"></circle>
    <path d="M20 1.25a18.75 18.75 0 0 1 0 37.5z" fill="#1f4fb5"></path>
    <path d="M8.5 33.5c6-4.5 13-8 16.5-19.5" fill="none" stroke="#e8a262" stroke-width="3" stroke-linecap="round"></path>
  </svg>
  <span class="words">
    <span class="name">Solutions <span class="for">for</span> Women</span>
    <span class="tag">Walking the road together</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
    --mark-fill: var(--paper);
    --mark-stroke: var(--ink);
  }
  .logo--light {
    color: var(--paper);
    --mark-fill: var(--navy);
    --mark-stroke: var(--paper);
  }
  .mark {
    width: 2.5rem;
    height: 2.5rem;
    flex: none;
  }
  .words {
    display: grid;
    line-height: 1;
  }
  .name {
    font-family: var(--serif);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .for {
    font-style: italic;
    font-weight: 400;
  }
  .tag {
    margin-top: 0.3rem;
    font-size: 0.75rem;
    font-weight: 500;
    opacity: 0.75;
    white-space: nowrap;
  }
</style>
