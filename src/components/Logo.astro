---
import Mark from './Mark.astro';

interface Props {
  tone?: 'dark' | 'light';
}
const { tone = 'dark' } = Astro.props;
---

<a href="/" class:list={['logo', `logo--${tone}`]} aria-label="Solutions for Women, home">
  <Mark class="mark" ring={tone === 'light'} />
  <span class="words">
    <span class="name">Solutions <span class="for">for</span> Women</span>
    <span class="tag">Walking the road together</span>
  </span>
</a>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
  }
  .logo--light {
    color: var(--paper);
  }
  .logo :global(.mark) {
    width: 2.75rem;
    height: 2.75rem;
    flex: none;
  }
  .words {
    display: grid;
    line-height: 1;
  }
  .name {
    font-family: var(--serif);
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }
  .for {
    font-style: italic;
    font-weight: 400;
  }
  .tag {
    margin-top: 0.3rem;
    font-size: 0.75rem;
    font-weight: 500;
    opacity: 0.75;
    white-space: nowrap;
  }
</style>
